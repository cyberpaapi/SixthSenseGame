{
  "buildCommand": "node scripts/build-mobile.js --web",
  "outputDirectory": "www",
  "functions": {
    "api/play-store.js": {
      "maxDuration": 30
    },
    "api/play-purchase.js": {
      "maxDuration": 30
    },
    "api/multiplayer.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/economy.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
